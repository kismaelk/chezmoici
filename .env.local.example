# ═══════════════════════════════════════════════════════
# CHEZMOICI — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ═══════════════════════════════════════════════════════

# Supabase — trouvez ces valeurs dans :
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# WhatsApp support (numéro sans le +)
NEXT_PUBLIC_WHATSAPP_NUMBER=2250700000000

# Admin — utilisé seulement si le profil n’a pas encore is_admin=true en base (fallback email)
# NEXT_PUBLIC_ADMIN_EMAIL_FALLBACK=votre.email@domaine.ci

# Google Maps — Google Cloud Console → APIs & Services → Credentials (clé API)
# Activez au minimum « Maps JavaScript API ». Restreignez la clé (référents HTTP + APIs).
# En production : .env.local n’est pas déployé — même nom dans Vercel (Settings → Environment Variables,
# environnement Production / Preview), puis redéploiement. Référents HTTP Google Cloud : domaine du site + *.vercel.app + localhost.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID (obligatoire pour AdvancedMarkerElement / repères avancés)
# Google Cloud Console → Google Maps Platform → Map Management → Map IDs → Create Map ID (JavaScript)
# Sans cette variable, la carte utilise google.maps.Marker (marqueurs classiques).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# LocalLogic (optionnel) — écoles / couches « lifestyle » si votre contrat couvre la zone
# Sans token, la carte fonctionne sans ce module (couverture souvent limitée hors Amérique du Nord)
NEXT_PUBLIC_LOCALLOGIC_TOKEN=

# URL publique du site (liens dans les e-mails / notifications modération)
# NEXT_PUBLIC_SITE_URL=https://www.chezmoici.com

# Notifications « annonce en vérification » (optionnel — au moins une variable pour envoyer)
# Slack : Incoming Webhook (https://api.slack.com/messaging/webhooks)
# SLACK_MODERATION_WEBHOOK_URL=https://hooks.slack.com/services/...

# Webhook générique (Make, Zapier, n8n, Discord, etc.) — POST JSON { event, annonce, auteur, adminUrl }
# MODERATION_NOTIFY_WEBHOOK_URL=https://...

# E-mail via Resend (https://resend.com) — domaine « From » à vérifier dans Resend
# RESEND_API_KEY=re_...
# MODERATION_NOTIFY_EMAIL=moderation@votredomaine.ci
# RESEND_FROM=Chez Moi CI <notifications@votredomaine.ci>
